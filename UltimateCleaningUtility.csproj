<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\EXEComputers.ico</ApplicationIcon>
    <AssemblyName>UltimateCleaningUtility</AssemblyName>
    <RootNamespace>UltimateCleaningUtility</RootNamespace>
    <Version>3.4.0</Version>
    <Authors>EXE COMPUTERS</Authors>
    <Product>Ultimate Cleaning Utility ReDesigned</Product>
    <Description>Ultimate Cleaning Utility ReDesigned — a Windows cleanup, diagnostics and maintenance utility. Made by EXE COMPUTERS.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\EXEComputersLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
